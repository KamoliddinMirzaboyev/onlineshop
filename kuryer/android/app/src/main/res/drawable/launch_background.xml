<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash — Dart SplashScreen (widgets/splash.dart) bilan bir xil
     gradient, shunda Flutter birinchi kadrni chizganda ko'rinadigan "sakrash"
     (oq ekrandan yashilga) bo'lmaydi — bitta uzluksiz splash ko'rinadi. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#22C55E"
                android:endColor="#16A34A"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
