<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash — Dart SplashScreen (widgets/splash.dart) bilan bir xil
     gradient + logo, shunda Flutter birinchi kadrni chizganda ko'rinadigan
     "sakrash" (oq ekrandan yashilga) bo'lmaydi. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#16A34A"
                android:endColor="#0F5132"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
