<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) o'zining tizim SplashScreen API'sini majburan
     ishlatadi — shusiz u oq fonda oddiy launcher iconni ko'rsatadi, keyin
     bizning yashil gradient (launch_background) va Dart animatsion splash
     chiqadi — natijada 2 xil splash ketma-ket ko'rinadi. Bu yerda tizim
     splash'ini ham brend rangi+logo bilan mos qilib qo'yamiz, shunda hammasi
     bir xil yashil fonda silliq davom etadi. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#16A34A</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
    </style>
</resources>
